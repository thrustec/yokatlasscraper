# PowerShell: .\scripts\setup.ps1 automatically creates a secure .env
# Don't commit the populated .env to git.
POSTGRES_PORT=5433
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
ATLAS_INGEST_PASSWORD=REPLACE_WITH_RANDOM_SECRET
ATLAS_API_PASSWORD=REPLACE_WITH_RANDOM_SECRET
ATLAS_ANALYTICS_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# Data API only; backend/setup-data-api.py leaves existing bot roles unchanged.
ATLAS_RAW_WRITER_PASSWORD=REPLACE_WITH_RANDOM_SECRET
ATLAS_ANALYTICS_READER_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DB_WRITE_API_KEY=REPLACE_WITH_RANDOM_SECRET
# Server-side only. Never put either value in frontend configuration.
TUIK_API_KEY=SET_TUIK_PORTAL_API_KEY
BOT_ADMIN_API_KEY=REPLACE_WITH_RANDOM_SECRET
