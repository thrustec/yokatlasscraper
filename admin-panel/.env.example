# Bu dosyayı .env adıyla kopyalayın ve doldurun:  cp .env.example .env
# .env dosyasını ASLA repoya koymayın (.gitignore'da olmalı).

# Veritabanı. Sunucudaki PostgreSQL Docker ağında "postgres" adıyla görünür (servis adı farklıysa değiştirin).
# Parola sunucudaki /home/<kullanıcı>/yokatlas/.env içindeki POSTGRES_ADMIN_PASSWORD.
ADMIN_DATABASE_URL=postgresql://db_user:REPLACE_ME@postgres:5432/yokatlas_intelligence
ADMIN_DB_NETWORK=yokatlas-intelligence_default
ADMIN_PORT=8090

# Botların kodunun bulunduğu repo klasörü (sunucudaki yol). Boş bırakılırsa admin-panel'in bir üst klasörü.
ADMIN_REPO_HOST_DIR=/home/deploy/yokatlas

# Aynı anda en fazla kaç bot çalışsın
ADMIN_MAX_PARALLEL_RUNS=2
ADMIN_TIMEZONE=Europe/Istanbul

# E-postalardaki "Paneli aç" bağlantısı (SSH tüneliyle girildiği için localhost)
ADMIN_PANEL_URL=http://localhost:8090

# E-posta (Gmail örneği: Google hesabında 2 adımlı doğrulama açık olmalı,
# sonra https://myaccount.google.com/apppasswords adresinden "uygulama şifresi" alınır)
ADMIN_SMTP_HOST=smtp.gmail.com
ADMIN_SMTP_PORT=587
ADMIN_SMTP_STARTTLS=1
ADMIN_SMTP_USER=ekip.hesabi@gmail.com
ADMIN_SMTP_PASSWORD=REPLACE_ME
ADMIN_SMTP_FROM=ÜniRota Panel <ekip.hesabi@gmail.com>
